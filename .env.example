# Copie este archivo a .env y sustituya los valores. NO suba .env al repositorio.

# --- Base de datos ---
POSTGRES_USER=quincena
POSTGRES_DB=quincena
POSTGRES_PASSWORD=CAMBIE_ESTA_CONTRASENA

# --- Aplicación ---
# Genere un secreto con:  openssl rand -hex 32
JWT_SECRETO=CAMBIE_ESTE_SECRETO_DE_AL_MENOS_32_CARACTERES
JWT_MINUTOS=480
ENTORNO=produccion
# true: cualquiera con acceso a la URL puede dar de alta una organización. Póngalo en false tras crear la suya.
PERMITIR_REGISTRO=true
MAX_MB_ARCHIVO=40
ZONA_HORARIA=America/Mexico_City
PUERTO_WEB=3000

# --- IA opcional (apagada por defecto; el flujo básico no la necesita) ---
# Si la activa, el TEXTO de la página de una fila pendiente se envía a un servicio externo
# cuando un usuario pide una sugerencia. Requiere además: pip install -r requirements-ia.txt
IA_HABILITADA=false
IA_MODELO=claude-opus-5-5
ANTHROPIC_API_KEY=
