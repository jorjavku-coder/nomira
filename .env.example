# Copie este archivo a .env y sustituya los valores. NO suba .env al repositorio.

# --- Base de datos ---
POSTGRES_USER=quincena
POSTGRES_DB=quincena
POSTGRES_PASSWORD=CAMBIE_ESTA_CONTRASENA

# --- Aplicación ---
# Genere un secreto con:  openssl rand -hex 32
JWT_SECRETO=CAMBIE_ESTE_SECRETO_DE_AL_MENOS_32_CARACTERES
JWT_MINUTOS=480
ENTORNO=produccion
# true: cualquiera con acceso a la URL puede dar de alta una organización. Póngalo en false tras crear la suya.
PERMITIR_REGISTRO=true
MAX_MB_ARCHIVO=40
ZONA_HORARIA=America/Mexico_City
PUERTO_WEB=3000
# Encabezado con la IP real del cliente, solo si delante hay un proxy de confianza que lo fija y
# no deja que el navegador lo falsifique (p. ej. True-Client-IP con Cloudflare, X-Real-IP con su nginx).
# Vacío: se usa la IP de la conexión. Sirve para la auditoría y el freno contra fuerza bruta.
IP_CLIENTE_ENCABEZADO=
# Panel de la plataforma (/plataforma): solicitudes, cuentas de clientes y soporte, SIN acceso a
# expedientes. Al arrancar se crea este administrador si no existe (contraseña de 12+ caracteres).
# Después la contraseña se cambia desde el panel; cambiar estos valores no la modifica.
PLATAFORMA_ADMIN_EMAIL=
PLATAFORMA_ADMIN_CONTRASENA=
# Botón de WhatsApp del sitio público: número con lada de país (México: 52 + 10 dígitos). Vacío = sin botón.
WHATSAPP_CONTACTO=

# --- Correos: bienvenida al crear un cliente y recordatorio antes de que venza su plan ---
# Dirección pública del sistema (para los enlaces y el logo de los correos).
URL_PUBLICA=http://localhost:3000
# resend | smtp | prueba (se guardan en STORAGE_DIR/correos_prueba) | vacío (no se envía nada)
# Fuera de producción NUNCA sale un correo real (se usa el modo prueba) salvo CORREO_ENVIO_REAL=true.
CORREO_PROVEEDOR=
CORREO_ENVIO_REAL=false
CORREO_REMITENTE=Nomira <hola@nomirasoft.com>
CORREO_RESPONDER_A=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PUERTO=465
SMTP_USUARIO=
SMTP_CONTRASENA=
# Días de anticipación del recordatorio de vencimiento (0 = apagado). Se revisa cada hora.
RECORDATORIO_DIAS=7

# --- IA opcional (apagada por defecto; el flujo básico no la necesita) ---
# Si la activa, el TEXTO de la página de una fila pendiente se envía a un servicio externo
# cuando un usuario pide una sugerencia. Requiere además: pip install -r requirements-ia.txt
IA_HABILITADA=false
IA_MODELO=claude-opus-5-5
ANTHROPIC_API_KEY=
